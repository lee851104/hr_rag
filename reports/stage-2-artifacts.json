    {
      "review_id": "S05",
      "chunk": {
        "effective_from": "2018-03-01",
        "effective_to": null,
        "id": "c-0178e79eef4d736dacc6cbef11875cd7aaed832dbba08798ec473cd3b4a7b3e5",
